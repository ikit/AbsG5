# Copier ce fichier en install/.env (non versionné) et renseigner des valeurs fortes.
# docker compose le lit automatiquement quand il est lancé depuis install/.
# Générer un secret : openssl rand -base64 48

# Sel de signature des jetons JWT (le changer invalide toutes les sessions)
AUTH_SESSION_SALT=

# Mot de passe PostgreSQL (partagé par absg5_db et absg5_core)
DB_PASSWORD=

# Compte d'administration pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
